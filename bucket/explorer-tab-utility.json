{
    "version": "2.6.0.1",
    "description": "Community-maintained fork of ExplorerTabUtility: supercharge Windows 11's File Explorer: auto-convert windows to tabs, duplicate tabs, reopen closed ones, and more",
    "##": [
        "Original upstream (kept for reference): https://github.com/w4po/ExplorerTabUtility",
        "Last upstream version: 2.5.0 (releases/download/v2.5.0/ExplorerTabUtility_v2.5.0_<arch>_Net9.0_FrameworkDependent.zip)"
    ],
    "homepage": "https://github.com/warthurton/ExplorerTabPlus",
    "license": "MIT",
    "notes": [
        "Requires the .NET 9 Desktop Runtime (framework-dependent build).",
        "Settings (%APPDATA%\\ExplorerTabUtility\\settings.json) are persisted via a junction to Scoop's persist directory."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/warthurton/ExplorerTabPlus/releases/download/v2.6.0.1/ExplorerTabUtility_v2.6.0.1_x64_Net9.0_FrameworkDependent.zip",
                        "hash": "6c175781c27c78d6b3b4baa9b85e4f0bdaf4a0e6ca23da0e510926ec0453f9f7"
        },
        "32bit": {
            "url": "https://github.com/warthurton/ExplorerTabPlus/releases/download/v2.6.0.1/ExplorerTabUtility_v2.6.0.1_x86_Net9.0_FrameworkDependent.zip",
                        "hash": "a66dcd959cfb192d2a419f3bedb513fd958590bcec0c727df5faea4dc2bf2e9f"
        },
        "arm64": {
            "url": "https://github.com/warthurton/ExplorerTabPlus/releases/download/v2.6.0.1/ExplorerTabUtility_v2.6.0.1_arm64_Net9.0_FrameworkDependent.zip",
                        "hash": "a8b59e350ef542d060dad086951e1c120afb4ea76bc632e7183d10e38642dacf"
        }
    },
    "extract_dir": "ExplorerTabUtility",
    "pre_install": [
        "$settings = \"$env:APPDATA\\ExplorerTabUtility\"",
        "ensure $persist_dir | Out-Null",
        "if ((Test-Path $settings) -and -not ((Get-Item $settings -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "    if (-not (Test-Path \"$persist_dir\\settings.json\")) { Copy-Item \"$settings\\*\" $persist_dir -Recurse -Force }",
        "    Remove-Item $settings -Recurse -Force",
        "}",
        "if (-not (Test-Path $settings)) { New-Item -ItemType Junction -Path $settings -Target $persist_dir | Out-Null }"
    ],
    "pre_uninstall": [
        "$settings = \"$env:APPDATA\\ExplorerTabUtility\"",
        "if ((Test-Path $settings) -and ((Get-Item $settings -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { [IO.Directory]::Delete($settings) }"
    ],
    "bin": "ExplorerTabUtility.exe",
    "shortcuts": [
        [
            "ExplorerTabUtility.exe",
            "ExplorerTabUtility"
        ]
    ],
    "checkver": {
        "github": "https://github.com/warthurton/ExplorerTabPlus"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/warthurton/ExplorerTabPlus/releases/download/v$version/ExplorerTabUtility_v$version_x64_Net9.0_FrameworkDependent.zip"
            },
            "32bit": {
                "url": "https://github.com/warthurton/ExplorerTabPlus/releases/download/v$version/ExplorerTabUtility_v$version_x86_Net9.0_FrameworkDependent.zip"
            },
            "arm64": {
                "url": "https://github.com/warthurton/ExplorerTabPlus/releases/download/v$version/ExplorerTabUtility_v$version_arm64_Net9.0_FrameworkDependent.zip"
            }
        }
    }
}
